{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning"
    }
  },
  "WhatsApp": {
    "IsEnabled": true,
    "BaseUrl": "https://whatsapp-gateway-mvno.onrender.com/",
    "SendMessageEndpoint": "/api/send",
    "GatewayToken": "wgp_live_f1edb88c660ce290e80d8de7386c7e4a2946b766ee40c33bf1140189e33115b8"
  },

  "FileUpload": {
    "MaxImageSizeInBytes": 10485760,
    "MaxVideoSizeInBytes": 209715200,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".gif" ],
    "AllowedVideoExtensions": [ ".mp4", ".mov", ".webm", ".m4v" ],
    "AllowedImageMimeTypes": [ "image/jpeg", "image/png", "image/webp", "image/gif" ],
    "AllowedVideoMimeTypes": [ "video/mp4", "video/quicktime", "video/webm", "video/x-m4v" ]
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },

    "Enrich": [
      "FromLogContext"
    ],

    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },

  "TenantSettings": {
    "DevelopmentDomain": "chougalefarms.com"
  },

  "AllowedHosts": "*"
}